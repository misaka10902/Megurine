# --- Android / Gradle 构建输出 ---
/build
app/build
app/release
local.properties

# --- IDE 配置 ---
.idea/
*.iml
*.iws

# --- Kotlin 编译缓存 ---
.kotlin/

# --- OS 文件 ---
.DS_Store
Thumbs.db

# --- 签名文件（敏感信息！） ---
keystore/

# --- 部署相关（敏感：SSH 私钥） ---
.deploy/

# --- 后端服务（独立部署到 ECS，不进公开仓库） ---
server/

# --- Gradle 包装器缓存 ---
.gradle/

# --- 其他 ---
/captures
.externalNativeBuild
.cxx
temp_*/

*.apk

# --- 签名密钥 ---
# 发布签名密钥随仓库维护在 signing/ 下，保证任何一次构建都是同一签名、
# 可以直接覆盖安装；其它位置的密钥仍然不入库。
*.jks
*.keystore
!signing/
!signing/*.jks

# --- 本地专用（密钥/内部文档，切勿上传）---
_local/

# --- 智能体本地数据 ---
.workbuddy/

# --- 本地临时产物 ---
*.log
*.tar.gz
*.tgz

# --- 打包产物（APK/源码包不入库）---
*.zip
*.apk
release/
